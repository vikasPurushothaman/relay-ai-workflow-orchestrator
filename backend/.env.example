# Mode, DB settings, API port/token prerequisite and DB timeout are bound in 2.5.
# Phase4/5 bind transport, recovery and AI adapter settings below.
# Copy to backend/.env locally. No automatic dotenv loader exists yet.
# Set api or worker for each process; deliberately blank to avoid an implicit mode.
RELAY_MODE=

# Host API/worker -> local MySQL (see task 2.6 Compose setup).
RELAY_DB_URL=jdbc:mysql://localhost:3306/relay
RELAY_DB_USER=relay
# URL: one MySQL host and schema; no credentials, query parameters or fragment.
# Supply your local database password; never put credentials in the JDBC URL.
RELAY_DB_PASSWORD=
RELAY_API_PORT=8080
# Exact comma-separated browser origins, no trailing slash; blank disables cross-origin access.
RELAY_ALLOWED_ORIGINS=http://localhost:5173
# Generate a private management token; never use it in VITE_* variables.
RELAY_DEMO_TOKEN=
# API startup inserts missing canonical Published workflows; preserves existing IDs.
RELAY_LOAD_SEEDS=true

# Keep the supplied seeds' localhost mock addresses unchanged.
MOCK_WORLD_URL=http://localhost:9210
RELAY_HTTP_ALLOWED_ORIGINS=http://localhost:9210
# mock-http is for transport/error testing: the supplied mock returns prose.
# Successful automated schema tests use controlled JSON fixtures; see Phase5 setup for real AI.
RELAY_AI_MODE=mock-http
RELAY_AI_BASE_URL=http://localhost:9001
# mock-http: blank model uses alpha-small and blank key uses a local mock token.
# openai: explicit model and key required; endpoint is fixed to api.openai.com.
# openrouter: use a prefixed model (openai/gpt-5-mini) and an OpenRouter key.
# Its endpoint is fixed to https://openrouter.ai/api/v1/chat/completions.
# Configure privately with python3 scripts/configure_ai.py from the project root.
RELAY_AI_MODEL=
RELAY_AI_API_KEY=

# Recovery defaults selected in docs/RECOVERY.md (milliseconds unless noted).
RELAY_HTTP_TIMEOUT_MS=10000
RELAY_AI_TIMEOUT_MS=30000
RELAY_JOB_POLL_MS=250
RELAY_JOB_LEASE_MS=60000
RELAY_JOB_RENEW_MS=10000
# Bootstrap accepts 1000..60000 ms for bounded connection and transaction waits.
RELAY_DB_TX_TIMEOUT_MS=5000
RELAY_RETRY_MAX_ATTEMPTS=3
RELAY_RETRY_BASE_MS=1000
RELAY_RETRY_MAX_MS=30000
